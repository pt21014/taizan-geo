/**
 * 五张注册表之五：**队列任务**（蓝图 §4.7、§7 扩展点⑦）。
 *
 * ## 这张表不是执行层的真源
 *
 * 队列的真源是**处理器类上的 `@JobHandler({ name })`**——`ProcessorFactory` 用
 * `DiscoveryService` 扫出它们并起 worker，不看这个文件。这里这份清单是给**人**和
 * **平台后台**用的：死信重放页要能把 `{{domainSlug}}.sync` 显示成「商品同步」而不是一串英文，
 * 运维要能一眼看全「这个应用一共有哪些后台任务」。
 *
 * 两者对不上（注册了却没有处理器、有处理器却没注册）这里只兜住一半：name 一律引用
 * 处理器文件里导出的常量，所以拼错是编译错误而不是运行时静默失配。
 * 完整的双向比对要等平台后台的死信页落地（T1-7），那时可以直接拿
 * `ProcessorFactory.discovered` 对账。
 *
 * ## 约定
 *
 * 任务名带模块前缀（`{{domainSlug}}.sync`），死信落 `JobDeadLetter` 并可在平台后台重放；
 * cron 一律 `@LeaderCron`（裸 `@Cron` 会在 4 个 PM2 实例上各跑一遍，这是 knowledge
 * 线上真实发生过的故障，由 `cluster-safe.spec.ts`（spec 12）看着）。
 *
 * @packageDocumentation
 */

// @taizan-example-start
import { {{DOMAIN_UPPER}}_SYNC_JOB_NAME } from '../modules/example-{{domainSlug}}/{{domainSlug}}-sync.handler'
// @taizan-example-end
import {
  GEO_ALERT_EVALUATE_JOB_NAME,
  GEO_DAILY_AGGREGATE_JOB_NAME,
  GEO_QUERY_EXECUTE_JOB_NAME,
  GEO_RESULT_ANALYZE_JOB_NAME,
  GEO_RUN_DISPATCH_JOB_NAME,
} from '../modules/geo/run/geo-job-names'

/** 一个队列任务的注册项。 */
export interface JobDef {
  /** 任务名，`module.action` 形式，全局唯一，**必须与 `@JobHandler({ name })` 一致**。 */
  name: string
  /**
   * 所属队列。
   *
   * `@taizan/nest-infra` 目前是「一个 name 一个队列」（`name` 即队列名），
   * 所以这里恒等于 `name`。字段留着是因为将来若要把若干低频任务并到一个队列上
   * （每个队列在 BullMQ 里都是一组常驻 key + 一条 worker 连接），改的是这里而不是调用点。
   */
  queue: string
  /** 给平台后台「死信重放」页显示用的中文名。 */
  title: string
}

/** 本应用注册的队列任务。 */
export const JOBS: readonly JobDef[] = [
// @taizan-example-start
  {
    name: {{DOMAIN_UPPER}}_SYNC_JOB_NAME,
    queue: {{DOMAIN_UPPER}}_SYNC_JOB_NAME,
    title: '{{domainName}}同步',
  },
// @taizan-example-end
  // ── GEO 跑批流水线（技术设计 §4.2） ────────────────────────────────
  //
  // 五条消息串成一条链：dispatch 把一次跑批展开成 N 条 execute，每条 execute 成功
  // 之后派生一条 analyze，最后一条收口时派生一条 daily.aggregate，
  // 聚合写完当天的汇总行之后再派生一条 alert.evaluate（T7）。
  // 死信重放页上它们会各自显示成下面这几个中文名——一串英文任务名对运维毫无帮助，
  // 而「查询执行」重试耗尽这件事是真的需要人去看一眼的（多半是密钥或额度出了问题）。
  {
    name: GEO_RUN_DISPATCH_JOB_NAME,
    queue: GEO_RUN_DISPATCH_JOB_NAME,
    title: 'GEO 跑批展开',
  },
  {
    name: GEO_QUERY_EXECUTE_JOB_NAME,
    queue: GEO_QUERY_EXECUTE_JOB_NAME,
    title: 'GEO 查询执行',
  },
  {
    name: GEO_RESULT_ANALYZE_JOB_NAME,
    queue: GEO_RESULT_ANALYZE_JOB_NAME,
    title: 'GEO 回答分析',
  },
  {
    // T7 起是真正的聚合（`aggregate/geo-daily-aggregate.handler.ts`）。
    // 它重试耗尽时那一天就没有聚合行，由 `geo-daily-aggregate` cron 在第二天
    // 凌晨兜底重算——所以它出现在死信页里是**要人看一眼**的，不是噪音。
    name: GEO_DAILY_AGGREGATE_JOB_NAME,
    queue: GEO_DAILY_AGGREGATE_JOB_NAME,
    title: 'GEO 每日聚合',
  },
  {
    // T7：聚合写完当天的汇总行之后派生。它是这条链上唯一一个**会往外发东西**
    // 的任务（站内信 + 短信），重试耗尽意味着「该报的警没报出去」——
    // 死信页上它比别的几条更值得看。
    name: GEO_ALERT_EVALUATE_JOB_NAME,
    queue: GEO_ALERT_EVALUATE_JOB_NAME,
    title: 'GEO 告警评估',
  },
]

/**
 * 加载期自检：任务名不重复。
 *
 * 重名的后果是两个处理器抢同一个队列，消息被随机分给其中一个——
 * 表现为「有一半的任务好像没跑」。`JobRegistry.discover()` 那边也会就重名抛错，
 * 但那是应用起来之后的事，而这份清单是人在写代码时看的，早一步炸更好。
 */
function assertNoDuplicateJobNames(): void {
  const seen = new Set<string>()
  for (const job of JOBS) {
    if (seen.has(job.name)) {
      throw new Error(
        `[{{scope}}/api] 队列任务 "${job.name}" 被重复注册；一个任务名只能有一个处理器。`,
      )
    }
    seen.add(job.name)
  }
}

assertNoDuplicateJobNames()
