/**
 * GEO 流水线四个队列任务的**任务名常量**（技术设计 §4.2）。
 *
 * ## 为什么它们不写在各自的 handler 文件里
 *
 * 最自然的写法是每个 handler 导出自己的 `XXX_JOB_NAME`（`example-{{domainSlug}}/{{domainSlug}}-sync.handler.ts`
 * 就是那样）。GEO 这条链上不行，因为它会绕出一个**运行时循环依赖**：
 *
 * ```
 * geo-run.service.ts      ──import 名字──> geo-run-dispatch.handler.ts
 * geo-run-dispatch.handler ──import 类──> geo-run.service.ts
 * ```
 *
 * TypeScript 编译得过（类型层面循环是允许的），但 Nest 在实例化 handler 时拿到的
 * `GeoRunService` 是 `undefined`，报成一句很有误导性的
 * 「Nest can't resolve dependencies … argument at index [2]」——而真正的原因既不是
 * 漏了 provider，也不是用了 `import type`。
 *
 * 同一条链上还有第二个环：`geo-query-execute.handler` → `analysis/geo-result-analyze.handler`
 * → `GeoRunService`（它要 `settle()`）→ dispatch handler。
 *
 * 把**纯字符串常量**抽到这个谁也不 import 的叶子文件里，两个环一起断掉。
 * 代价是任务名与 handler 不在同一个文件里；收益是这条依赖关系从此是一棵树。
 *
 * `registry/jobs.ts` 也从这里 import——它引用的是同一份常量，拼错是编译错误而不是
 * 运行时的静默失配。
 *
 * @packageDocumentation
 */

/** `geo.run.dispatch`：把一次跑批展开成 N 条待执行的查询。 */
export const GEO_RUN_DISPATCH_JOB_NAME = 'geo.run.dispatch'

/** `geo.query.execute`：真的去问一次 AI。**唯一花钱的那一条**。 */
export const GEO_QUERY_EXECUTE_JOB_NAME = 'geo.query.execute'

/** `geo.result.analyze`：把回答正文变成结构化的提及与引用。 */
export const GEO_RESULT_ANALYZE_JOB_NAME = 'geo.result.analyze'

/** `geo.daily.aggregate`：把一天的回答聚合成 `GeoVisibilityDaily`。 */
export const GEO_DAILY_AGGREGATE_JOB_NAME = 'geo.daily.aggregate'

/**
 * `geo.alert.evaluate`：按当天与前一天的汇总行评估告警规则并发通知。
 *
 * 它由 `geo.daily.aggregate` 在写完当天的 `GeoVisibilityDaily` 之后派生——
 * 顺序不能反：告警比的是「今天 vs 昨天」的汇总行，聚合没写完就评估等于拿半份数据报警。
 */
export const GEO_ALERT_EVALUATE_JOB_NAME = 'geo.alert.evaluate'
