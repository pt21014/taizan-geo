import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'

/**
 * 平台超管后台（T3-4）。dev 端口固定 {{platformPort}}（`apps/admin` 用 5174 附近的另一个端口，
 * 两个后台不该抢端口）；`/api` 代理到 `apps/api` 的 {{apiPort}}，接口路径里已经带了完整的
 * `/api/platform/...` 前缀，这里的 baseURL 留空即可（见 `src/session.ts`）。
 */
export default defineConfig(({ command }) => ({
  // 生产挂载在 https://www.{{rootDomain}}/platform 子路径下；本地 dev 仍走根路径，
  // 不然 `pnpm dev` 打开 http://localhost:{{platformPort}} 会变成要求先手动加 /platform/。
  base: command === 'build' ? '/platform/' : '/',
  plugins: [react()],
  server: {
    port: {{platformPort}},
    proxy: {
      '/api': {
        target: 'http://localhost:{{apiPort}}',
        changeOrigin: true,
      },
    },
  },
  preview: {
    port: {{platformPort}},
  },
  build: {
    outDir: 'dist',
    emptyOutDir: true,
  },
}))
